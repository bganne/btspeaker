[Unit]
Description=Bluetooth A2DP speaker (btspeaker)
After=network-online.target sound.target
Wants=network-online.target
Conflicts=bluetooth.service
# Never give up restarting (a peer that keeps crashing us must not stop the service for good).
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/btspeaker
# If BTSPEAKER_HTTP_PASSWORD is set there: chmod 600 /etc/default/btspeaker
EnvironmentFile=-/etc/default/btspeaker
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=3

# DynamicUser also implies ProtectSystem=strict, PrivateTmp, NoNewPrivileges,
# RestrictSUIDSGID and RemoveIPC.
DynamicUser=yes
StateDirectory=btspeaker
StateDirectoryMode=0700
UMask=0077
# netdev: /dev/rfkill is root:netdev 0664 (Debian ifupdown's udev rule); used to
# lift a soft rfkill block on the adapter at start and restore it at stop.
SupplementaryGroups=audio netdev
# CAP_NET_BIND_SERVICE: L2CAP PSMs below 0x1001 (SDP 1, AVCTP 23, AVDTP 25) need it.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# Single core shared with mpd: favour the audio path over mpd/web, but no RT scheduling
# (a busy RT process would starve the kworkers running the BT/USB stack).
Nice=-10
# GC tightens before the cgroup OOM-kills us.
Environment=GOMEMLIMIT=40MiB

# Resource caps: backstop for connection floods/leaks, protects mpd on the same box.
LimitNOFILE=256
MemoryMax=64M
TasksMax=64

# Hardening. PrivateDevices is deliberately not used: /dev/snd must stay visible.
# AF_BLUETOOTH is required for the mgmt and L2CAP sockets.
RestrictAddressFamilies=AF_BLUETOOTH AF_UNIX AF_INET AF_INET6
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# DeviceAllow implies DevicePolicy=closed (plus /dev/null, /dev/urandom, ...).
DeviceAllow=char-alsa rw
DeviceAllow=/dev/rfkill rw
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
MemoryDenyWriteExecute=yes
# No ProtectProc=invisible / ProcSubset=pid: bluetoothdRunning() scans /proc/*/comm.

[Install]
WantedBy=multi-user.target
